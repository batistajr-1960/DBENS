, situacao_processo
, segredo_justica
, area_processo
, deassunto
, cc_deassuntocomplementar
, dt_local_fisico
, de_local_fisico
, decompllocal
, de_tipo_distribuicao
, dt_distribuicao
, nome_vara
, nome_foro
, nome_juiz
, justica_gratuita
, valor_causa
, migrado_pje
FROM saj_pg_consulta_publica.saj_processos_filtro
order by nuprocesso")
